{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "devCommand": "vite",
  "crons": [
    {
      "path": "/api/batch",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/batch-schedule",
      "schedule": "0 0 * * *"
    }
  ]
} 